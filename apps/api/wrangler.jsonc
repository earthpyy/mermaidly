{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mermaidly-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-26",
  // Serve the worker at api.mermaidly.app. Requires the mermaidly.app zone to
  // be on this Cloudflare account; the hostname is provisioned on deploy.
  "routes": [{ "pattern": "api.mermaidly.app", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
  // KV namespace storing shortId -> { code, viewOnly }.
  // The binding name must stay "LINKS" — the worker references env.LINKS.
  "kv_namespaces": [
    {
      "binding": "LINKS",
      "id": "087ef385acdd4cb595f692a8a84554a8",
    },
  ],
  "vars": {
    // Comma-separated list of allowed origins for CORS. Use "*" to allow any.
    "ALLOWED_ORIGINS": "https://mermaidly.app",
  },
}
